 /// Should not be sprinkled around carelessly, as it causes a little bit of overhead.
 #[inline]
 pub fn ensure_sufficient_stack<R>(f: impl FnOnce() -> R) -> R {
+    // stacker can't find the stack limit on WebAssembly, so it would switch
+    // to a freshly allocated stack on *every* call: 200x slower in practice.
+    // Run on the fixed stack instead, whose size is set when linking.
+    // (Patched in by rust-js.)
+    if cfg!(target_family = "wasm") {
+        return f();
+    }
     stacker::maybe_grow(RED_ZONE, STACK_PER_RECURSION, f)
 }
