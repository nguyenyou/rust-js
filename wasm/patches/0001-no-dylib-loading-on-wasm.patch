+/// WebAssembly has no dynamic libraries, so neither proc-macro crates nor
+/// codegen backends can be loaded from them. (Patched in by rust-js.)
+#[cfg(target_family = "wasm")]
+pub unsafe fn load_symbol_from_dylib<T: Copy>(
+    path: &Path,
+    _sym_name: &str,
+) -> Result<T, DylibError> {
+    let err = "loading dynamic libraries is not supported on WebAssembly".to_string();
+    Err(DylibError::DlOpen(path.display().to_string(), err))
