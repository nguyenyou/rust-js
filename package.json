{
  "name": "rust-js",
  "private": true,
  "type": "module",
  "description": "Compile Rust to readable JavaScript. Every task is a script here: `bun run` lists them.",
  "workspaces": [
    "web",
    "react",
    "wasm/web",
    "vite-plugin",
    "examples/vite-react"
  ],
  "scripts": {
    "setup": "bun install && bunx --bun playwright install chromium",
    "build": "cargo build && react/build.sh -o \"$PWD/target/libreact.rmeta\"",
    "test": "bun test",
    "generate": "bun web/generate.ts",
    "generate:react": "bun react/generate.ts",
    "react-example": "bun run --cwd examples/vite-react dev",
    "wasm": "wasm/build.sh",
    "dev": "bun run --cwd wasm/web dev",
    "site": "bun run --cwd wasm/web build",
    "preview": "bun wasm/web/preview.ts",
    "deploy": "gh workflow run deploy-playground.yml",
    "ship": "bun run wasm && wasm/prebuilt.sh publish && bun run deploy",
    "test:compiler": "bun test test/compiler.test.ts test/diagnostics.test.ts test/emission.test.ts",
    "test:react": "bun test test/react.test.ts",
    "test:browser": "bun test test/browser.test.ts",
    "test:vite": "bun test test/vite.test.ts",
    "test:playground": "bun test test/playground.test.ts"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@happy-dom/global-registrator": "20.14.5",
    "@playwright/test": "1.63.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "5.0.2",
    "babel-plugin-react-compiler": "1.0.0",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "vite": "8.3.0",
    "vitest": "5.0.2"
  }
}
